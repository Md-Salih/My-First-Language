#include <iostream>
#include <unordered_map>
#include <queue>
#include <vector>
using namespace std;

int main(){
    int n,k;
    cout<<"Enter n and k: ";
    cin>>n>>k;
    vector<int> arr(n);
    for(int i=0;i<n;i++) cin>>arr[i];

    unordered_map<int,int> freq;
    for(int x:arr) freq[x]++;

    priority_queue<pair<int,int>> pq;
    for(auto &p:freq) pq.push({p.second,p.first});

    cout<<k<<" most frequent elements: ";
    while(k-- && !pq.empty()){
        cout<<pq.top().second<<" ";
        pq.pop();
    }
}
